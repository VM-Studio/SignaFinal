{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "gru1"
  ],
  "buildCommand": "prisma generate && prisma migrate deploy && next build",
  "crons": [
    {
      "path": "/api/alertas/evaluar",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/jobs/eta",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cusat/sincronizar",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/jobs/recordatorios",
      "schedule": "* * * * *"
    }
  ]
}
