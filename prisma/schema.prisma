// SIGNA · Logística — modelo de datos
// Reglas que Prisma no puede expresar (un lugar a la vez, únicos parciales, CHECKs)
// viven en la migración SQL "reglas_de_negocio".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Conexión directa (sin pooler) para migraciones. En local, la misma que DATABASE_URL.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ═══════════════════════════════ NÚCLEO ═══════════════════════════════

enum Rol {
  DIRECCION
  RESPONSABLE_OBRA
  CAPATAZ
  CHOFER
  DEPOSITO
  ADMINISTRACION
  COMPRAS // una sola persona hace todas las compras de la empresa
}

model Usuario {
  id                  String    @id @default(cuid())
  nombre              String
  email               String    @unique
  passwordHash        String
  rol                 Rol
  telefono            String?
  activo              Boolean   @default(true)
  // Solo choferes
  licenciaCategoria   String?
  licenciaVencimiento DateTime? @db.Date
  // La camioneta propia (si tiene)
  vehiculoAsignadoId  String?   @unique
  creadoEn            DateTime  @default(now())
  actualizadoEn       DateTime  @updatedAt

  vehiculoAsignado          Vehiculo?                  @relation("VehiculoPropio", fields: [vehiculoAsignadoId], references: [id])
  vehiculosACargo           Vehiculo[]                 @relation("VehiculoAsignadoA")
  obrasACargo               ResponsableObra[]
  pedidosSolicitados        PedidoViaje[]              @relation("PedidoSolicitante")
  pedidosTomados            PedidoViaje[]              @relation("PedidoTomadoPor")
  viajes                    Viaje[]
  cargasCombustible         CargaCombustible[]
  incidentes                IncidenteVehiculo[]
  herramientasACargo        Herramienta[]
  movimientosRegistrados    MovimientoHerramienta[]    @relation("MovimientoRegistradoPor")
  movimientosRecibidos      MovimientoHerramienta[]    @relation("MovimientoRecibidoPor")
  mantenimientosHerramienta MantenimientoHerramienta[] @relation("MantenimientoHerramientaRegistro")
  auditoria                 Auditoria[]
  posiciones                PosicionVehiculo[]
  notificaciones            Notificacion[]
  suscripcionesPush         SuscripcionPush[]
  materialesPedidos         PedidoMaterial[]           @relation("MaterialSolicitante")
  materialesTomados         PedidoMaterial[]           @relation("MaterialComprador")
  materialesAprobados       PedidoMaterial[]           @relation("MaterialAprobador")
  cambiosMaterial           CambioEstadoMaterial[]
  materialesHabilitados     MaterialListo[]
  enviosPush                EnvioPush[]
  adjuntosSubidos           Adjunto[]
  ocCreadas                 OrdenCompra[]              @relation("OCCreadaPor")
  ocAprobadas               OrdenCompra[]              @relation("OCAprobadaPor")
  ocSolicitadas             OrdenCompra[]              @relation("OCSolicitante")
  recordatorios             Recordatorio[]

  @@index([rol, activo])
}

enum EstadoObra {
  ACTIVA
  PAUSADA
  FINALIZADA
}

model Obra {
  id             String     @id @default(cuid())
  nombre         String
  codigo         String     @unique
  direccion      String
  localidad      String
  latitud        Float
  longitud       Float
  estado         EstadoObra @default(ACTIVA)
  idLebane       String?    @unique
  radioGeocercaM Int        @default(200)
  creadoEn       DateTime   @default(now())
  actualizadoEn  DateTime   @updatedAt

  responsables        ResponsableObra[]
  pedidos             PedidoViaje[]
  pedidosMaterial     PedidoMaterial[]
  materialesListos    MaterialListo[]
  cargasCombustible   CargaCombustible[]
  herramientas        Herramienta[]
  existencias         ExistenciaHerramienta[]
  movimientosDesde    MovimientoHerramienta[] @relation("MovDesdeObra")
  movimientosHacia    MovimientoHerramienta[] @relation("MovHaciaObra")
  sobrantesOriginados MaterialSobrante[]
  sedes               ObraSede[]
  ordenesCompra       OrdenCompra[]

  @@index([estado])
}

// Obra con más de un frente (ej. Edén): cada sede tiene su dirección. Si la obra tiene sedes, el
// pedido de viaje elige a cuál va.
model ObraSede {
  id        String   @id @default(cuid())
  obraId    String
  nombre    String
  direccion String
  localidad String
  latitud   Float
  longitud  Float
  activa    Boolean  @default(true)
  creadoEn  DateTime @default(now())

  obra            Obra             @relation(fields: [obraId], references: [id])
  pedidos         PedidoViaje[]
  pedidosMaterial PedidoMaterial[]

  @@index([obraId, activa])
}

// Una obra tiene uno o más responsables; uno puede ser el principal (recibe herramientas, etc.).
model ResponsableObra {
  id        String    @id @default(cuid())
  obraId    String
  usuarioId String
  principal Boolean   @default(false)
  // Nada se borra: al sacarle una obra a alguien, la asignación queda inactiva con su fecha.
  activo    Boolean   @default(true)
  hastaEn   DateTime?
  creadoEn  DateTime  @default(now())

  obra    Obra    @relation(fields: [obraId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([obraId, usuarioId])
  @@index([usuarioId])
  @@index([usuarioId, activo])
}

// El proveedor es la empresa; lo que se elige y a donde va el chofer es la SUCURSAL.
model Proveedor {
  id       String   @id @default(cuid())
  nombre   String
  cuit     String?
  telefono String?
  email    String?
  rubro    String?
  notas    String?
  activo   Boolean  @default(true)
  idLebane String?  @unique
  creadoEn DateTime @default(now())

  sucursales       SucursalProveedor[]
  pedidos          PedidoViaje[]
  materialesListos MaterialListo[]
  ordenesCompra    OrdenCompra[]

  @@index([nombre])
  @@index([cuit])
}

model SucursalProveedor {
  id            String   @id @default(cuid())
  proveedorId   String
  nombre        String // "Casa central", "Sucursal Pilar"
  direccion     String
  localidad     String
  latitud       Float
  longitud      Float
  horarioRetiro String?
  contacto      String?
  telefono      String?
  principal     Boolean  @default(false)
  activa        Boolean  @default(true)
  creadoEn      DateTime @default(now())

  proveedor        Proveedor       @relation(fields: [proveedorId], references: [id])
  materialesListos MaterialListo[]
  pedidos          PedidoViaje[]
  ordenesCompra    OrdenCompra[]

  @@index([proveedorId, activa])
}

enum TipoUbicacion {
  DEPOSITO
  BASE_VEHICULOS
  DESCARGA // volquete / descarga de escombros
  VARIOS
}

model Ubicacion {
  id        String        @id @default(cuid())
  nombre    String
  tipo      TipoUbicacion
  // Cómo le dice la gente: "Galpón", "Terreno", "Base". Se usa en los textos del chofer.
  etiqueta  String?
  direccion String
  localidad String?
  latitud   Float
  longitud  Float
  activa    Boolean       @default(true)

  vehiculosBase    Vehiculo[]
  herramientas     Herramienta[]
  existencias      ExistenciaHerramienta[]
  movimientosDesde MovimientoHerramienta[] @relation("MovDesdeUbicacion")
  movimientosHacia MovimientoHerramienta[] @relation("MovHaciaUbicacion")

  @@index([tipo])
}

// ═══════════════════════════════ FLOTA ═══════════════════════════════

enum TipoVehiculo {
  CAMION
  CAMIONETA
  AUTO
  MAQUINA
}

enum EstadoVehiculo {
  DISPONIBLE
  EN_VIAJE
  EN_TALLER
  FUERA_DE_SERVICIO
}

model Vehiculo {
  id                   String         @id @default(cuid())
  nombre               String
  patente              String         @unique
  tipo                 TipoVehiculo
  marca                String
  modelo               String
  anio                 Int
  capacidadCargaKg     Int            @default(0)
  kmActual             Int            @default(0)
  horasMotor           Int?
  costoKm              Decimal        @db.Decimal(12, 2)
  estado               EstadoVehiculo @default(DISPONIBLE)
  entraEnCola          Boolean        @default(true)
  asignadoAId          String?
  baseId               String?
  idCusat              String?        @unique
  // El nombre tal cual aparece en Cusat ("MERCEDES 710"): para emparejar si la patente no alcanza.
  cusatNombre          String?
  // Última posición conocida (Cusat o teléfono): el mapa la lee de acá sin tocar PosicionVehiculo.
  ultimaLat            Float?
  ultimaLng            Float?
  ultimaFechaGps       DateTime?
  ultimaVelocidad      Float?
  ultimaDireccionTexto String?
  fotoUrl              String?
  activo               Boolean        @default(true)
  creadoEn             DateTime       @default(now())
  actualizadoEn        DateTime       @updatedAt

  asignadoA      Usuario?                @relation("VehiculoAsignadoA", fields: [asignadoAId], references: [id])
  usuarioPropio  Usuario?                @relation("VehiculoPropio")
  base           Ubicacion?              @relation(fields: [baseId], references: [id])
  documentos     DocumentoVehiculo[]
  cargas         CargaCombustible[]
  mantenimientos MantenimientoVehiculo[]
  incidentes     IncidenteVehiculo[]
  viajes         Viaje[]
  posiciones     PosicionVehiculo[]

  @@index([activo, entraEnCola, tipo])
  @@index([estado])
  @@index([asignadoAId])
}

enum TipoDocumentoVehiculo {
  SEGURO
  VTV
  PATENTE
  CEDULA
  RUTA
  OTRO
}

model DocumentoVehiculo {
  id          String                @id @default(cuid())
  vehiculoId  String
  tipo        TipoDocumentoVehiculo
  vencimiento DateTime?             @db.Date
  archivoUrl  String?
  notas       String?
  creadoEn    DateTime              @default(now())

  vehiculo Vehiculo @relation(fields: [vehiculoId], references: [id])

  @@index([vehiculoId, tipo])
  @@index([vencimiento])
}

model CargaCombustible {
  id             String   @id @default(cuid())
  vehiculoId     String
  usuarioId      String
  fecha          DateTime @default(now())
  litros         Decimal  @db.Decimal(10, 2)
  monto          Decimal  @db.Decimal(12, 2)
  km             Int
  comprobanteUrl String?
  obraId         String?
  clientId       String?  @unique // idempotencia sin señal

  vehiculo Vehiculo @relation(fields: [vehiculoId], references: [id])
  usuario  Usuario  @relation(fields: [usuarioId], references: [id])
  obra     Obra?    @relation(fields: [obraId], references: [id])

  @@index([vehiculoId, fecha])
  @@index([obraId])
}

enum TipoMantenimiento {
  SERVICE
  REPARACION
  NEUMATICOS
  OTRO
}

model MantenimientoVehiculo {
  id           String            @id @default(cuid())
  vehiculoId   String
  tipo         TipoMantenimiento
  fecha        DateTime          @db.Date
  km           Int
  descripcion  String
  taller       String?
  costo        Decimal           @db.Decimal(12, 2)
  proximoKm    Int?
  proximaFecha DateTime?         @db.Date

  vehiculo Vehiculo @relation(fields: [vehiculoId], references: [id])

  @@index([vehiculoId, fecha])
}

enum TipoIncidente {
  MULTA
  SINIESTRO
  ROTURA
  ROBO
}

model IncidenteVehiculo {
  id          String        @id @default(cuid())
  vehiculoId  String
  usuarioId   String?
  tipo        TipoIncidente
  fecha       DateTime
  descripcion String
  monto       Decimal       @default(0) @db.Decimal(12, 2)
  resuelto    Boolean       @default(false)

  vehiculo Vehiculo @relation(fields: [vehiculoId], references: [id])
  usuario  Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([vehiculoId, resuelto])
}

// ═════════════════════════ PEDIDOS Y VIAJES ═════════════════════════

enum TipoPedido {
  RETIRO_PROVEEDOR
  TRASLADO_MAQUINARIA
  TRASLADO_HERRAMIENTAS
  LLEVAR_A_OBRA
  RETIRO_ESCOMBROS
  TRASLADO_PERSONAS
  OTRO
}

enum OrigenTipo {
  BASE
  PROVEEDOR
  DEPOSITO
  OBRA
}

enum Prioridad {
  NORMAL
  URGENTE
}

enum Franja {
  MANANA
  TARDE
  HORA_EXACTA
}

enum EstadoPedido {
  PENDIENTE
  TOMADO
  EN_VIAJE
  ENTREGADO
  CANCELADO
}

model PedidoViaje {
  id                String       @id @default(cuid())
  numero            Int          @unique @default(autoincrement())
  clientId          String?      @unique // idempotencia del pedido hecho sin señal
  solicitanteId     String
  obraId            String // destino
  tipo              TipoPedido
  origenTipo        OrigenTipo
  // Id de Ubicacion (BASE/DEPOSITO), Proveedor u Obra según origenTipo
  origenId          String
  proveedorId       String?
  // Retiro en proveedor: la sucursal (origenId también apunta a ella).
  sucursalId        String?
  // Destino: si la obra tiene sedes, a cuál va.
  destinoSedeId     String?
  // El viaje que lo lleva ahora (puede llevar varios pedidos: ViajePedido tiene el detalle).
  viajeId           String?
  // Si el viaje lleva una máquina o herramienta del depósito: herramientas y viajes quedan unidos.
  herramientaId     String?
  // Retiro en proveedor: solo se crea desde materiales habilitados por Compras (MaterialListo).
  esRetiroMaterial  Boolean      @default(false)
  // Día en que se necesita la herramienta: misma herramienta + obra + día = duplicado exacto.
  fechaNecesaria    DateTime?    @db.Date
  ordenCompraLebane String?
  descripcion       String
  pesoKg            Int?
  cantidadPersonas  Int?
  necesitaCamion    Boolean      @default(false)
  paraCuando        DateTime
  franja            Franja       @default(MANANA)
  prioridad         Prioridad    @default(NORMAL)
  estado            EstadoPedido @default(PENDIENTE)
  tomadoPorId       String?
  tomadoEn          DateTime?
  motivoCancelacion String?
  canceladoEn       DateTime?
  // Origen y destino resueltos al crear: el chofer y el mapa nunca tienen que buscarlos.
  origenNombre      String
  origenDireccion   String
  origenLat         Float
  origenLng         Float
  destinoNombre     String
  destinoDireccion  String
  destinoLat        Float
  destinoLng        Float
  creadoEn          DateTime     @default(now())
  actualizadoEn     DateTime     @updatedAt

  solicitante      Usuario            @relation("PedidoSolicitante", fields: [solicitanteId], references: [id])
  obra             Obra               @relation(fields: [obraId], references: [id])
  proveedor        Proveedor?         @relation(fields: [proveedorId], references: [id])
  sucursal         SucursalProveedor? @relation(fields: [sucursalId], references: [id])
  destinoSede      ObraSede?          @relation(fields: [destinoSedeId], references: [id])
  herramienta      Herramienta?       @relation(fields: [herramientaId], references: [id])
  tomadoPor        Usuario?           @relation("PedidoTomadoPor", fields: [tomadoPorId], references: [id])
  viaje            Viaje?             @relation("ViajeActual", fields: [viajeId], references: [id])
  viajesPrincipal  Viaje[]            @relation("ViajePrincipal")
  enViajes         ViajePedido[]
  itemsParada      ItemParada[]
  materialesListos MaterialListo[]

  @@index([estado, prioridad, paraCuando])
  @@index([obraId, estado])
  @@index([tomadoPorId, estado])
  @@index([solicitanteId])
  @@index([herramientaId, estado])
  @@index([herramientaId, obraId, fechaNecesaria])
  @@index([viajeId])
  @@index([sucursalId])
  // Solicitudes pendientes: urgentes primero, después por fecha necesaria.
  @@index([estado, prioridad, fechaNecesaria])
}

// El ciclo del viaje. EstadoViaje se deriva de la etapa (ver src/lib/viajes/etapas.ts).
enum EtapaViaje {
  PROGRAMADO
  HACIA_RETIRO
  EN_RETIRO
  HACIA_DESTINO
  EN_DESTINO
  FINALIZADO
}

enum EstadoViaje {
  PROGRAMADO
  EN_CURSO
  FINALIZADO
  CANCELADO // el chofer soltó el pedido o se canceló antes de salir
}

model Viaje {
  id                String      @id @default(cuid())
  // Pedido principal (el primero aceptado). Los pedidos del viaje están en ViajePedido.
  pedidoId          String
  vehiculoId        String
  choferId          String
  salidaEstimada    DateTime?
  ordenRuta         Int? // orden en la ruta del día del chofer
  salidaReal        DateTime?
  llegadaReal       DateTime?
  kmSalida          Int?
  kmLlegada         Int?
  peajes            Decimal     @default(0) @db.Decimal(12, 2)
  costoCalculado    Decimal?    @db.Decimal(12, 2)
  remitoUrl         String?
  observaciones     String?
  // Idempotencia de los envíos hechos sin señal.
  clientIdInicio    String?     @unique
  clientIdFin       String?     @unique
  // Compatibilidad: se deriva de etapa (PROGRAMADO / EN_CURSO / FINALIZADO), salvo CANCELADO.
  estado            EstadoViaje @default(PROGRAMADO)
  etapa             EtapaViaje  @default(PROGRAMADO)
  inicioEn          DateTime?
  llegadaRetiroEn   DateTime?
  salidaRetiroEn    DateTime?
  llegadaDestinoEn  DateTime?
  // Lo que calculó el ruteo al empezar cada tramo.
  distanciaRetiroM  Int?
  duracionRetiroS   Int?
  distanciaDestinoM Int?
  duracionDestinoS  Int?
  // Se recalculan con cada posición nueva.
  etaRetiro         DateTime?
  etaDestino        DateTime?
  // Motor de viajes (src/lib/viajes/motor.ts): lecturas candidatas, última lectura válida,
  // llegada para confirmar, confirmación rechazada y aviso de "sin señal".
  motor             Json?
  // Suma de los tramos entre paradas (lo que calculó el armado de la ruta).
  distanciaTotalM   Int?

  pedido       PedidoViaje             @relation("ViajePrincipal", fields: [pedidoId], references: [id])
  pedidos      PedidoViaje[]           @relation("ViajeActual")
  paradas      ViajeParada[]
  viajePedidos ViajePedido[]
  vehiculo     Vehiculo                @relation(fields: [vehiculoId], references: [id])
  chofer       Usuario                 @relation(fields: [choferId], references: [id])
  movimientos  MovimientoHerramienta[]
  posiciones   PosicionVehiculo[]

  @@index([vehiculoId, estado])
  @@index([choferId, estado])
  @@index([choferId, etapa])
  @@index([llegadaReal])
  @@index([pedidoId])
}

// ═════════════════════════ PARADAS DEL VIAJE ═════════════════════════
// Un viaje es una lista ordenada de paradas (retiro o entrega). Un pedido simple = 2 paradas.

enum TipoParada {
  RETIRO
  ENTREGA
}

enum LugarParada {
  PROVEEDOR_SUCURSAL
  DEPOSITO
  OBRA
  OBRA_SEDE
  BASE
  OTRO
}

enum EstadoParada {
  PENDIENTE
  EN_CAMINO
  LLEGO
  COMPLETADA
  SALTEADA
}

model ViajeParada {
  id                      String       @id @default(cuid())
  viajeId                 String
  orden                   Int
  tipo                    TipoParada
  lugarTipo               LugarParada
  lugarId                 String?
  nombre                  String
  direccion               String
  latitud                 Float
  longitud                Float
  estado                  EstadoParada @default(PENDIENTE)
  llegadaEn               DateTime?
  salidaEn                DateTime?
  distanciaDesdeAnteriorM Int?
  duracionDesdeAnteriorS  Int?
  remitoUrl               String?
  notas                   String?

  viaje          Viaje         @relation(fields: [viajeId], references: [id])
  items          ItemParada[]
  pedidosRetiro  ViajePedido[] @relation("ParadaRetiro")
  pedidosEntrega ViajePedido[] @relation("ParadaEntrega")

  @@index([viajeId, orden])
}

model ViajePedido {
  id              String   @id @default(cuid())
  viajeId         String
  pedidoViajeId   String
  paradaRetiroId  String?
  paradaEntregaId String
  orden           Int      @default(0)
  // Parte del costo del viaje imputada a este pedido (se calcula al finalizar).
  costoImputado   Decimal? @db.Decimal(12, 2)

  viaje         Viaje        @relation(fields: [viajeId], references: [id])
  pedido        PedidoViaje  @relation(fields: [pedidoViajeId], references: [id])
  paradaRetiro  ViajeParada? @relation("ParadaRetiro", fields: [paradaRetiroId], references: [id])
  paradaEntrega ViajeParada  @relation("ParadaEntrega", fields: [paradaEntregaId], references: [id])

  @@unique([viajeId, pedidoViajeId])
  @@index([pedidoViajeId])
}

// Lista de verificación de cada parada: qué cargar o descargar, para qué obra.
model ItemParada {
  id                String    @id @default(cuid())
  paradaId          String
  pedidoViajeId     String
  descripcion       String // "40 bolsas de cemento"
  cantidad          Decimal?  @db.Decimal(12, 2)
  unidad            String?
  // Lo que realmente se cargó o entregó, si no fue todo ("retiraron 30 de 40").
  cantidadReal      Decimal?  @db.Decimal(12, 2)
  faltante          Boolean   @default(false)
  nota              String?
  ordenCompraNumero String?
  obraNombre        String
  marcado           Boolean   @default(false)
  marcadoEn         DateTime?

  parada ViajeParada @relation(fields: [paradaId], references: [id])
  pedido PedidoViaje @relation(fields: [pedidoViajeId], references: [id])

  @@index([paradaId])
  @@index([pedidoViajeId])
}

enum FuentePosicion {
  TELEFONO // la app del chofer durante el viaje
  CUSAT // rastreo satelital
  MOCK // simulador
}

model PosicionVehiculo {
  id             String         @id @default(cuid())
  vehiculoId     String
  latitud        Float
  longitud       Float
  velocidad      Float          @default(0)
  rumbo          Float          @default(0)
  motorEncendido Boolean        @default(false)
  fecha          DateTime       @default(now())
  fuente         FuentePosicion @default(MOCK)
  viajeId        String?
  usuarioId      String?
  precisionM     Float?

  vehiculo Vehiculo @relation(fields: [vehiculoId], references: [id])
  viaje    Viaje?   @relation(fields: [viajeId], references: [id])
  usuario  Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([vehiculoId, fecha])
  @@index([viajeId, fecha])
}

// ═══════════════════════════════ DEPÓSITO ═══════════════════════════════

model CategoriaHerramienta {
  id     String @id @default(cuid())
  nombre String @unique

  herramientas Herramienta[]
}

enum TipoControl {
  UNITARIA
  CANTIDAD
}

enum EstadoHerramienta {
  DISPONIBLE
  EN_OBRA
  EN_REPARACION
  EXTRAVIADA
  BAJA
}

enum Condicion {
  BUENA
  REGULAR
  MALA
}

model Herramienta {
  id                    String            @id @default(cuid())
  codigo                String            @unique // SIG-0001
  nombre                String
  categoriaId           String
  esMaquina             Boolean           @default(false)
  tipoControl           TipoControl       @default(UNITARIA)
  marca                 String?
  modelo                String?
  nroSerie              String?
  estado                EstadoHerramienta @default(DISPONIBLE)
  condicion             Condicion         @default(BUENA)
  // Dónde está (solo UNITARIA): en el depósito o en una obra, nunca ambos.
  ubicacionId           String?
  obraId                String?
  responsableId         String?
  devolucionPrevista    DateTime?         @db.Date
  valorCompra           Decimal?          @db.Decimal(14, 2)
  fotoUrl               String?
  mantenimientoCadaDias Int?
  proximoMantenimiento  DateTime?         @db.Date
  activo                Boolean           @default(true)
  creadoEn              DateTime          @default(now())
  actualizadoEn         DateTime          @updatedAt

  categoria      CategoriaHerramienta       @relation(fields: [categoriaId], references: [id])
  ubicacion      Ubicacion?                 @relation(fields: [ubicacionId], references: [id])
  obra           Obra?                      @relation(fields: [obraId], references: [id])
  responsable    Usuario?                   @relation(fields: [responsableId], references: [id])
  existencias    ExistenciaHerramienta[]
  movimientos    MovimientoHerramienta[]
  pedidos        PedidoViaje[]
  mantenimientos MantenimientoHerramienta[]

  @@index([estado, activo])
  @@index([obraId])
  @@index([categoriaId])
  @@index([devolucionPrevista])
}

// Stock de herramientas por CANTIDAD: una fila por (herramienta, lugar).
model ExistenciaHerramienta {
  id            String  @id @default(cuid())
  herramientaId String
  ubicacionId   String?
  obraId        String?
  cantidad      Int     @default(0)

  herramienta Herramienta @relation(fields: [herramientaId], references: [id])
  ubicacion   Ubicacion?  @relation(fields: [ubicacionId], references: [id])
  obra        Obra?       @relation(fields: [obraId], references: [id])

  @@unique([herramientaId, ubicacionId, obraId])
  @@index([obraId])
}

enum TipoMovimiento {
  ENTREGA
  DEVOLUCION
  TRANSFERENCIA
  A_REPARACION
  DE_REPARACION
  EXTRAVIO
  BAJA
}

model MovimientoHerramienta {
  id               String         @id @default(cuid())
  herramientaId    String
  tipo             TipoMovimiento
  desdeUbicacionId String?
  desdeObraId      String?
  haciaUbicacionId String?
  haciaObraId      String?
  cantidad         Int            @default(1)
  condicion        Condicion?
  registradoPorId  String
  recibidoPorId    String?
  viajeId          String?
  fecha            DateTime       @default(now())
  observaciones    String?

  herramienta    Herramienta @relation(fields: [herramientaId], references: [id])
  desdeUbicacion Ubicacion?  @relation("MovDesdeUbicacion", fields: [desdeUbicacionId], references: [id])
  desdeObra      Obra?       @relation("MovDesdeObra", fields: [desdeObraId], references: [id])
  haciaUbicacion Ubicacion?  @relation("MovHaciaUbicacion", fields: [haciaUbicacionId], references: [id])
  haciaObra      Obra?       @relation("MovHaciaObra", fields: [haciaObraId], references: [id])
  registradoPor  Usuario     @relation("MovimientoRegistradoPor", fields: [registradoPorId], references: [id])
  recibidoPor    Usuario?    @relation("MovimientoRecibidoPor", fields: [recibidoPorId], references: [id])
  viaje          Viaje?      @relation(fields: [viajeId], references: [id])

  @@index([herramientaId, fecha])
  @@index([fecha])
}

model MantenimientoHerramienta {
  id              String   @id @default(cuid())
  herramientaId   String
  fecha           DateTime @db.Date
  descripcion     String
  taller          String?
  costo           Decimal  @default(0) @db.Decimal(12, 2)
  registradoPorId String
  creadoEn        DateTime @default(now())

  herramienta   Herramienta @relation(fields: [herramientaId], references: [id])
  registradoPor Usuario     @relation("MantenimientoHerramientaRegistro", fields: [registradoPorId], references: [id])

  @@index([herramientaId, fecha])
}

enum CategoriaSobrante {
  CONSTRUCCION
  ELECTRICO
  SANITARIO
  OTRO
}

model MaterialSobrante {
  id           String            @id @default(cuid())
  descripcion  String
  categoria    CategoriaSobrante
  cantidad     Decimal           @db.Decimal(12, 2)
  unidad       String
  obraOrigenId String?
  fecha        DateTime          @default(now())
  // Nada se borra: cuando se usa o se descarta, queda la baja con motivo.
  bajaEn       DateTime?
  motivoBaja   String?

  obraOrigen Obra? @relation(fields: [obraOrigenId], references: [id])

  @@index([categoria, bajaEn])
}

// ═════════════════════════ ALERTAS Y AUDITORÍA ═════════════════════════

enum Severidad {
  AVISO
  CRITICA
}

enum EstadoAlerta {
  ABIERTA
  VISTA
  RESUELTA
}

model Alerta {
  id              String       @id @default(cuid())
  claveUnica      String       @unique // regla:entidad — nunca se duplica
  regla           String
  severidad       Severidad
  titulo          String
  detalle         String
  entidadTipo     String
  entidadId       String
  enlace          String?
  // A quién le toca: la obra (la ve su responsable) y/o la persona (ej.: el chofer).
  obraId          String?
  usuarioId       String?
  // Roles que la ven (matriz en src/lib/alertas/destinatarios.ts). Nadie más la ve.
  rolesDestino    Rol[]        @default([])
  // Personas puntuales que la ven (los solicitantes, el chofer, quien tiene la herramienta).
  usuariosDestino String[]     @default([])
  estado          EstadoAlerta @default(ABIERTA)
  creadaEn        DateTime     @default(now())
  resueltaEn      DateTime?

  @@index([estado, severidad])
  @@index([entidadTipo, entidadId])
  @@index([regla, estado])
  @@index([obraId])
  @@index([usuarioId])
  @@index([usuariosDestino], type: Gin)
  @@index([rolesDestino], type: Gin)
}

model Auditoria {
  id        String   @id @default(cuid())
  usuarioId String?
  rol       Rol?
  accion    String
  entidad   String
  entidadId String
  // Texto corto legible: "Daniela pidió hierro para Obra Darwin".
  resumen   String
  antes     Json?
  despues   Json?
  ip        String?
  userAgent String?
  fecha     DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([entidad, entidadId])
  @@index([usuarioId, fecha])
  @@index([fecha])
}

// ═══════════════════════════ AVISOS A PERSONAS ═══════════════════════════

enum TipoNotificacion {
  PEDIDO_ACEPTADO
  VIAJE_INICIADO
  LLEGO_RETIRO
  LLEGO_DESTINO
  SALIO_RETIRO
  SIN_SENAL
  PEDIDO_SOLTADO
  PEDIDO_CANCELADO
  NUEVA_SOLICITUD
  SOLICITUD_URGENTE
  HERRAMIENTA_VENCIDA
  DUPLICADO
  MATERIAL
  ORDEN_COMPRA
  RECORDATORIO
  GENERAL
}

model Notificacion {
  id            String           @id @default(cuid())
  usuarioId     String
  tipo          TipoNotificacion
  titulo        String
  cuerpo        String
  enlace        String?
  datos         Json? // distancia, eta, etc.
  creadaEn      DateTime         @default(now())
  leidaEn       DateTime?
  enviadaPushEn DateTime?

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, leidaEn])
  @@index([usuarioId, creadaEn])
}

model SuscripcionPush {
  id                String    @id @default(cuid())
  usuarioId         String
  endpoint          String    @unique
  p256dh            String
  auth              String
  userAgent         String?
  creadaEn          DateTime  @default(now())
  activa            Boolean   @default(true)
  // Diagnóstico: el último envío (qué respondió Apple o Google) y cuándo el teléfono confirmó que la recibió.
  ultimoEnvioEn     DateTime?
  ultimoEnvioEstado String?
  ultimaRecepcionEn DateTime?

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  envios EnvioPush[]

  @@index([usuarioId, activa])
}

// ═══════════════════════════════ ARCHIVOS ═══════════════════════════════
// Fotos de remitos, tickets y documentación. Se guardan comprimidas en la base
// y se sirven con sesión en /api/archivos/[id].

model Archivo {
  id          String   @id @default(cuid())
  tipo        String // image/jpeg, application/pdf
  nombre      String?
  datos       Bytes
  tamano      Int
  subidoPorId String?
  creadoEn    DateTime @default(now())
}

enum EntidadAdjunto {
  PEDIDO_MATERIAL
  ORDEN_COMPRA
  VIAJE
  HERRAMIENTA
  VEHICULO
}

// Archivos adjuntos (PDF, Excel, Word, CSV, fotos) en Vercel Blob (src/lib/archivos.ts).
// entidadId queda vacío mientras se suben y se completa al confirmar el formulario.
model Adjunto {
  id          String         @id @default(cuid())
  entidadTipo EntidadAdjunto
  entidadId   String?
  nombre      String
  url         String
  tipoMime    String
  tamanoBytes Int
  // Interno de Compras (presupuestos, notas): el solicitante no lo ve.
  interno     Boolean        @default(false)
  subidoPorId String
  creadoEn    DateTime       @default(now())

  subidoPor Usuario @relation(fields: [subidoPorId], references: [id])

  @@index([entidadTipo, entidadId])
}

// Caché de geocodificación (Nominatim pide máximo 1 consulta por segundo).
model GeocodeCache {
  texto               String   @id // normalizado: minúsculas, sin acentos, espacios simples
  lat                 Float
  lng                 Float
  direccionFormateada String
  candidatos          Json     @default("[]")
  fecha               DateTime @default(now())
}

// ═══════════════════════════ MATERIALES Y COMPRAS ═══════════════════════════
// Los materiales no se piden a los choferes: se piden a Compras (CLAUDE.md, "Materiales y Compras").

enum EstadoMaterial {
  SOLICITADO
  EN_COMPRA
  ESPERANDO_APROBACION
  APROBADO
  LISTO_PARA_RETIRAR
  RETIRO_PEDIDO
  EN_CAMINO
  ENTREGADO
  CANCELADO
}

enum FuenteMaterial {
  MANUAL
  LEBANE // cuando llegue la API: EN_COMPRA → APROBADO se leen de la OC de Lebane
}

model PedidoMaterial {
  id                  String         @id @default(cuid())
  numero              Int            @unique @default(autoincrement())
  obraId              String
  solicitanteId       String
  descripcion         String // qué y cuánto (resumen; con solo adjuntos: "Ver lista adjunta (planilla.xlsx)")
  // Renglones: [{ descripcion, cantidad, unidad }]. Opcionales si viene un adjunto.
  renglones           Json?
  // Si la obra tiene sedes: para cuál.
  obraSedeId          String?
  cantidad            Decimal?       @db.Decimal(12, 2)
  unidad              String?
  paraCuando          DateTime       @db.Date
  prioridad           Prioridad      @default(NORMAL)
  estado              EstadoMaterial @default(SOLICITADO)
  fuente              FuenteMaterial @default(MANUAL)
  ordenCompraNumero   String?
  ordenCompraLebaneId String?
  montoAprobado       Decimal?       @db.Decimal(14, 2)
  aprobadoPorId       String?
  aprobadoEn          DateTime?
  tomadoPorId         String? // Compras
  tomadoEn            DateTime?
  // "Con esto no falta nada del pedido": al entregarse todas las habilitaciones, queda ENTREGADO.
  completo            Boolean        @default(false)
  motivoCancelacion   String?
  observaciones       String?
  // Notas internas de Compras: el solicitante no las ve.
  notasCompras        String?
  // La orden de compra vigente (puede haber otras rechazadas o anuladas).
  ordenCompraId       String?        @unique
  creadoEn            DateTime       @default(now())
  actualizadoEn       DateTime       @updatedAt

  ordenCompra      OrdenCompra?           @relation("OCVigente", fields: [ordenCompraId], references: [id])
  obraSede         ObraSede?              @relation(fields: [obraSedeId], references: [id])
  ordenesCompra    OrdenCompra[]          @relation("OCsDelPedido")
  obra             Obra                   @relation(fields: [obraId], references: [id])
  solicitante      Usuario                @relation("MaterialSolicitante", fields: [solicitanteId], references: [id])
  tomadoPor        Usuario?               @relation("MaterialComprador", fields: [tomadoPorId], references: [id])
  aprobadoPor      Usuario?               @relation("MaterialAprobador", fields: [aprobadoPorId], references: [id])
  cambios          CambioEstadoMaterial[]
  materialesListos MaterialListo[]

  @@index([obraId, estado])
  @@index([estado, paraCuando])
  @@index([solicitanteId])
}

/**
 * Historial de estados del pedido de material (la línea de tiempo de 8 pasos).
 */
model CambioEstadoMaterial {
  id               String          @id @default(cuid())
  pedidoMaterialId String
  de               EstadoMaterial?
  a                EstadoMaterial
  usuarioId        String?
  fecha            DateTime        @default(now())
  nota             String?

  pedidoMaterial PedidoMaterial @relation(fields: [pedidoMaterialId], references: [id])
  usuario        Usuario?       @relation(fields: [usuarioId], references: [id])

  @@index([pedidoMaterialId, fecha])
}

enum EstadoMaterialListo {
  LISTO
  RETIRO_PEDIDO
  EN_CAMINO
  ENTREGADO
  CANCELADO
}

enum ModoEntrega {
  RETIRA_CHOFER
  ENTREGA_PROVEEDOR // el proveedor lo lleva: no hay viaje
}

/**
 * Habilitación: material listo para retirar (un pedido puede tener varias: retiros parciales).
 */
model MaterialListo {
  id                   String              @id @default(cuid())
  pedidoMaterialId     String
  obraId               String // copiado del pedido
  proveedorId          String
  sucursalId           String
  // Copiados al habilitar, por si el proveedor cambia después.
  proveedorDireccion   String
  proveedorLat         Float
  proveedorLng         Float
  horarioRetiro        String? // "lun a vie 8 a 12"
  contactoRetiro       String?
  ordenCompraNumero    String?
  descripcion          String // qué se retira en ESTE retiro
  pesoKg               Int?
  necesitaCamion       Boolean             @default(false)
  modoEntrega          ModoEntrega         @default(RETIRA_CHOFER)
  fechaEntregaEstimada DateTime?           @db.Date
  // Renglones de la OC que entran en este retiro: [{ descripcion, cantidad, unidad }]. Lista de verificación del chofer.
  renglones            Json?
  estado               EstadoMaterialListo @default(LISTO)
  habilitadoPorId      String
  habilitadoEn         DateTime            @default(now())
  // El viaje que lo lleva (varios materiales del mismo proveedor pueden ir en el mismo viaje).
  pedidoViajeId        String?
  entregadoEn          DateTime?

  pedidoMaterial PedidoMaterial    @relation(fields: [pedidoMaterialId], references: [id])
  obra           Obra              @relation(fields: [obraId], references: [id])
  proveedor      Proveedor         @relation(fields: [proveedorId], references: [id])
  sucursal       SucursalProveedor @relation(fields: [sucursalId], references: [id])
  habilitadoPor  Usuario           @relation(fields: [habilitadoPorId], references: [id])
  pedidoViaje    PedidoViaje?      @relation(fields: [pedidoViajeId], references: [id])

  @@index([obraId, estado])
  @@index([pedidoMaterialId])
  @@index([pedidoViajeId])
}

/// Estado de procesos del sistema (clave → valor): última sincronización con Cusat, último error,
/// vehículos de Cusat sin enlazar, días de historial ya guardados.
model EstadoSistema {
  clave         String   @id
  valor         Json
  actualizadoEn DateTime @updatedAt
}

/// Cada intento de mandar una push a un dispositivo: qué respondió Apple/Google/Mozilla (diagnóstico).
model EnvioPush {
  id              String   @id @default(cuid())
  usuarioId       String
  suscripcionId   String
  /// Tipo del aviso (o "PRUEBA" para "Enviarme una prueba").
  tipo            String
  /// ENVIADA (el servicio la aceptó) o FALLIDA.
  estado          String
  codigoRespuesta Int?
  error           String?
  fecha           DateTime @default(now())

  usuario     Usuario         @relation(fields: [usuarioId], references: [id])
  suscripcion SuscripcionPush @relation(fields: [suscripcionId], references: [id])

  @@index([usuarioId, fecha])
  @@index([suscripcionId, fecha])
}

// ═════════════════════════ ÓRDENES DE COMPRA ═════════════════════════
// Compras arma la OC con un formulario; el PDF sale de estos datos (nunca al revés).

enum MetodoPago {
  ACOPIO
  CUENTA_CORRIENTE
  TRANSFERENCIA
  EFECTIVO
  ECHEQ
}

enum Moneda {
  ARS
  USD
}

enum EstadoOC {
  BORRADOR
  ESPERANDO_APROBACION
  APROBADA
  RECHAZADA
  ANULADA
}

model OrdenCompra {
  id                  String      @id @default(cuid())
  // OC-AAAA-NNNN. Se asigna al pasar a ESPERANDO_APROBACION (los borradores no gastan número).
  numero              String?     @unique
  anio                Int?
  secuencia           Int?
  pedidoMaterialId    String
  obraId              String
  solicitanteId       String
  proveedorId         String?
  sucursalId          String?
  fecha               DateTime    @default(now()) @db.Date
  fechaNecesaria      DateTime?   @db.Date
  metodoPago          MetodoPago?
  moneda              Moneda      @default(ARS)
  condiciones         String?
  observaciones       String?
  notasInternas       String?
  subtotal            Decimal?    @db.Decimal(14, 2)
  iva                 Decimal?    @db.Decimal(14, 2)
  // 21 por defecto; null = sin IVA.
  ivaPorcentaje       Decimal?    @db.Decimal(5, 2)
  total               Decimal?    @db.Decimal(14, 2)
  estado              EstadoOC    @default(BORRADOR)
  creadaPorId         String
  enviadaEn           DateTime?
  aprobadaPorId       String?
  aprobadaEn          DateTime?
  motivoRechazo       String?
  motivoAnulacion     String?
  pdfUrl              String?
  pdfAprobadaUrl      String?
  // Sube con cada edición.
  version             Int         @default(1)
  // Cuando exista la API de Lebane: el número que le asigne Lebane.
  ordenCompraLebaneId String?
  creadoEn            DateTime    @default(now())
  actualizadoEn       DateTime    @updatedAt

  pedidoMaterial PedidoMaterial     @relation("OCsDelPedido", fields: [pedidoMaterialId], references: [id])
  vigenteDe      PedidoMaterial?    @relation("OCVigente")
  obra           Obra               @relation(fields: [obraId], references: [id])
  solicitante    Usuario            @relation("OCSolicitante", fields: [solicitanteId], references: [id])
  proveedor      Proveedor?         @relation(fields: [proveedorId], references: [id])
  sucursal       SucursalProveedor? @relation(fields: [sucursalId], references: [id])
  creadaPor      Usuario            @relation("OCCreadaPor", fields: [creadaPorId], references: [id])
  aprobadaPor    Usuario?           @relation("OCAprobadaPor", fields: [aprobadaPorId], references: [id])
  renglones      RenglonOC[]

  @@index([estado, enviadaEn])
  @@index([pedidoMaterialId])
  @@index([proveedorId])
  @@index([obraId])
}

model RenglonOC {
  id             String   @id @default(cuid())
  ordenCompraId  String
  orden          Int
  descripcion    String
  cantidad       Decimal  @db.Decimal(12, 2)
  unidad         String
  precioUnitario Decimal? @db.Decimal(14, 2)
  subtotal       Decimal? @db.Decimal(14, 2)

  ordenCompra OrdenCompra @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)

  @@index([ordenCompraId, orden])
}

// Último número usado por año. Se toma con bloqueo de fila (src/lib/compras/numerar.ts).
model NumeradorOC {
  anio   Int @id
  ultimo Int @default(0)
}

// ═════════════════════════ RECORDATORIOS ═════════════════════════

enum TipoRecordatorio {
  VIAJE_MANANA
  VIAJE_HOY
  VIAJE_SIN_INICIAR
  RESUMEN_DIRECCION
}

model Recordatorio {
  id             String           @id @default(cuid())
  usuarioId      String
  tipo           TipoRecordatorio
  entidadId      String
  programadoPara DateTime
  enviadoEn      DateTime?
  canceladoEn    DateTime?
  // tipo:usuario:entidad:momento — un recordatorio nunca se programa dos veces.
  claveUnica     String           @unique
  creadoEn       DateTime         @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([programadoPara, enviadoEn])
  @@index([entidadId])
}
