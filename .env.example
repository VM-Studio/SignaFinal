# Postgres. En Vercel lo crea la integración de Neon.
DATABASE_URL="postgresql://usuario:clave@localhost:5432/signa"
# Conexión directa para migraciones (en Neon, la URL sin "-pooler"). En local, la misma.
DATABASE_URL_UNPOOLED="postgresql://usuario:clave@localhost:5432/signa"
# Secreto para firmar la sesión: openssl rand -base64 48
AUTH_SECRET=""
# true = datos de demo y mocks de Lebane/Cusat
MODO_DEMO="true"
# URL pública (para los QR y enlaces)
APP_URL="http://localhost:3000"
# Token de los cron (/api/posiciones, /api/alertas/evaluar, /api/demo/reiniciar)
CRON_SECRET=""
# Solo demo: el simulador de Cusat mueve los viajes N veces más rápido
SIMULADOR_ACELERAR="1"
# Cusat real (cuando llegue la documentación): con esto se deja de usar el simulador
CUSAT_API_URL=""
CUSAT_API_KEY=""
